<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Tech Shop</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <header>
        <h1 id="title">Online Tech Shop</h1>
        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Index">Products</a>
            <a asp-controller="Cart" asp-action="Index">Cart (<span id="cartCount">0</span>)</a>
            <a href="#">Login</a>
            <a href="#">Admin</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>Online Tech Shop</p>
        <p>Contact us</p>
        <p>Help</p>
        <p>Q&amp;A</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
